{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "local-config.schema.json",
  "title": "AEXOS Local Configuration (L4)",
  "description": "Machine-specific settings stored in .aexos-core/local-config.yaml (gitignored)",
  "type": "object",
  "properties": {
    "_aexos_migration": {
      "type": "object",
      "description": "Migration-only literal null paths. Remove a path to restore normal null-as-delete behavior for that key. Never appears in resolved configuration.",
      "required": ["version", "literal_null_paths"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": 1 },
        "literal_null_paths": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "not": { "enum": ["__proto__", "prototype", "constructor"] } }
          }
        }
      }
    },
    "ide": {
      "type": "object",
      "description": "IDE-specific overrides"
    },
    "mcp": {
      "type": "object",
      "description": "MCP server local overrides"
    }
  },
  "additionalProperties": true
}
