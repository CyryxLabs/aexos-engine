{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aexos.cyryxlabs.com/schemas/local-plan-policy-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policyVersion",
    "runHash",
    "projectRoot",
    "budgetScope",
    "budgetCeilingUsd",
    "grants",
    "allowChildProcessIO"
  ],
  "properties": {
    "policyVersion": {
      "const": 1
    },
    "runHash": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "projectRoot": {
      "type": "string",
      "minLength": 1
    },
    "budgetScope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "budgetCeilingUsd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "allowChildProcessIO": {
      "type": "boolean"
    },
    "grants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agentId",
          "task",
          "capability",
          "action",
          "resource",
          "scope"
        ],
        "properties": {
          "agentId": {
            "type": "string",
            "minLength": 1
          },
          "task": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "enum": [
              "filesystem",
              "process"
            ]
          },
          "action": {
            "enum": [
              "read",
              "guarded-create",
              "guarded-recoverable-replace",
              "guarded-recover",
              "node-test"
            ]
          },
          "resource": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
