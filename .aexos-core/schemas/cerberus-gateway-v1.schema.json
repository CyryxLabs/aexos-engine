{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aexos.cyryxlabs.com/schemas/cerberus-gateway-v1.json",
  "title": "AEXOS Cerberus Gateway v1 Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "requestId", "idempotencyKey", "operation", "projectId", "payload"],
  "properties": {
    "protocol": { "const": "aexos.cerberus/v1" },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "idempotencyKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$" },
    "operation": { "enum": ["ingest", "query"] },
    "projectId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "operation": { "const": "ingest" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "document"],
            "properties": {
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "type", "sha256"],
                "properties": {
                  "id": { "type": "string", "minLength": 1, "maxLength": 256 },
                  "type": { "enum": ["txt", "markdown", "pdf", "docx", "video-transcript"] },
                  "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                }
              },
              "document": {
                "type": "object",
                "additionalProperties": false,
                "required": ["encoding", "data"],
                "properties": {
                  "encoding": { "enum": ["utf8", "base64"] },
                  "data": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "operation": { "const": "query" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "limit"],
            "properties": {
              "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
              "sourceIds": {
                "type": "array",
                "maxItems": 100,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "maxLength": 256 }
              }
            }
          }
        }
      }
    }
  ]
}
