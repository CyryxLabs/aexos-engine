{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aexos.local/schemas/research-v1.schema.json",
  "title": "AEXOS durable research protocols",
  "definitions": {
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxSources", "maxOperations", "maxAttemptsPerOperation", "maxElapsedMs", "maxInputBytes", "maxContentBytes", "maxStateBytes", "maxCheckpointCount", "budget"],
      "properties": {
        "maxSources": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maxOperations": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maxAttemptsPerOperation": { "type": "integer", "minimum": 1, "maximum": 20 },
        "maxElapsedMs": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "maxInputBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "maxContentBytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "maxStateBytes": { "type": "integer", "minimum": 4096, "maximum": 4194304 },
        "maxCheckpointCount": { "type": "integer", "minimum": 4, "maximum": 512 },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "maximum"],
          "properties": {
            "unit": { "const": "collection-attempt" },
            "maximum": { "type": "integer", "minimum": 0, "maximum": 2000 }
          }
        }
      }
    },
    "sourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedAccessClasses", "privateHandling", "secretHandling", "normalizationVersion"],
      "properties": {
        "allowedAccessClasses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["public", "private"] }
        },
        "privateHandling": { "enum": ["exclude", "metadata-only"] },
        "secretHandling": { "enum": ["reject", "redact"] },
        "normalizationVersion": { "const": "utf8-crlf-v1" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapterId", "version", "kind", "identityStatus", "reportedEngine", "verification"],
      "properties": {
        "adapterId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "kind": { "enum": ["fixture", "mock", "unavailable", "external"] },
        "identityStatus": { "enum": ["exposed", "unexposed"] },
        "reportedEngine": { "type": ["string", "null"], "maxLength": 128 },
        "verification": { "const": "unverified" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observationId", "operationId", "originalLocator", "canonicalLocator", "locatorId", "retrievedAt", "collectorId", "collectorVersion", "provider", "availability", "originalContentHash", "previousCitationId", "observationIndex"],
      "properties": {
        "observationId": { "type": "string", "pattern": "^o-[a-f0-9]{64}$" },
        "operationId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "originalLocator": { "type": "string", "maxLength": 4096 },
        "canonicalLocator": { "type": "string", "maxLength": 4096 },
        "locatorId": { "type": "string", "pattern": "^l-[a-f0-9]{64}$" },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "collectorId": { "type": "string", "maxLength": 64 },
        "collectorVersion": { "type": "string", "maxLength": 32 },
        "provider": { "$ref": "#/definitions/provider" },
        "availability": { "enum": ["available", "unavailable"] },
        "originalContentHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "previousCitationId": { "type": ["string", "null"], "pattern": "^(s|m)-[a-f0-9]{64}$" },
        "observationIndex": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citationId", "contentHash", "normalizationVersion", "accessClass", "retainedContent", "metadataOnly", "inaccessible", "observations"],
      "properties": {
        "citationId": { "type": "string", "pattern": "^(s|m)-[a-f0-9]{64}$" },
        "contentHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "normalizationVersion": { "const": "utf8-crlf-v1" },
        "accessClass": { "enum": ["public", "private"] },
        "retainedContent": { "type": ["string", "null"], "maxLength": 65536 },
        "metadataOnly": { "type": "boolean" },
        "inaccessible": { "type": "boolean" },
        "observations": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "$ref": "#/definitions/observation" } }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attemptedCollections", "committedCollections", "uniqueVersions", "duplicateObservations", "retries", "consumedLogicalUnits", "bytesRetained", "elapsedMs", "currencySpend", "measurementStatus"],
      "properties": {
        "attemptedCollections": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "committedCollections": { "type": "integer", "minimum": 0, "maximum": 100 },
        "uniqueVersions": { "type": "integer", "minimum": 0, "maximum": 100 },
        "duplicateObservations": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "retries": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "consumedLogicalUnits": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "bytesRetained": { "type": "integer", "minimum": 0, "maximum": 4194304 },
        "elapsedMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "currencySpend": { "type": "null" },
        "measurementStatus": { "const": "not-observed" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "type", "at", "payload", "previousHash", "hash"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 2048 },
        "type": { "type": "string", "maxLength": 64 },
        "at": { "type": "string", "format": "date-time" },
        "payload": { "type": "object" },
        "previousHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "previousCheckpointHash", "committedOperationIds", "operations", "deadlineAt", "planHash", "policyHash"],
      "properties": {
        "revision": { "type": "integer", "minimum": 0, "maximum": 512 },
        "previousCheckpointHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "committedOperationIds": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" } },
        "operations": {
          "type": "array", "minItems": 1, "maxItems": 100,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["operationId", "status", "attempts", "reservations"],
            "properties": {
              "operationId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
              "status": { "enum": ["pending", "committed"] },
              "attempts": { "type": "integer", "minimum": 0, "maximum": 20 },
              "reservations": {
                "type": "array", "maxItems": 20,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["attempt", "unit", "status"],
                  "properties": {
                    "attempt": { "type": "integer", "minimum": 1, "maximum": 20 },
                    "unit": { "const": "collection-attempt" },
                    "status": { "enum": ["pending", "committed", "failed", "interrupted"] }
                  }
                }
              }
            }
          }
        },
        "deadlineAt": { "type": "string", "format": "date-time" },
        "planHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "runId", "query", "profile", "sourcePolicy", "provider", "operations", "claims", "comparisons", "uncertainty", "openQuestions", "limits"],
      "properties": {
        "schemaVersion": { "const": "aexos.research-plan/v1" },
        "runId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "query": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "profile": { "const": "fixture-local" },
        "sourcePolicy": { "$ref": "#/definitions/sourcePolicy" },
        "provider": { "$ref": "#/definitions/provider" },
        "operations": {
          "type": "array", "minItems": 1, "maxItems": 100,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["operationId", "fixture"],
            "properties": {
              "operationId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
              "fixture": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}\\.json$" }
            }
          }
        },
        "claims": { "type": "array", "maxItems": 500, "items": { "type": "object" } },
        "comparisons": { "type": "array", "maxItems": 100, "items": { "type": "object" } },
        "uncertainty": { "type": "array", "maxItems": 200, "items": { "type": "string", "maxLength": 2048 } },
        "openQuestions": { "type": "array", "maxItems": 200, "items": { "type": "string", "maxLength": 2048 } },
        "limits": { "$ref": "#/definitions/limits" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "runId", "planHash", "policyHash", "query", "profile", "status", "reasonCode", "sourcePolicy", "provider", "sources", "claims", "decisions", "uncertainty", "metrics", "events", "openQuestions", "limits", "recovery", "createdAt", "updatedAt", "lineageStatus", "providerVerification", "recommendationVerification", "diagnostics"],
      "properties": {
        "schemaVersion": { "const": "aexos.research/v1" },
        "runId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "planHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "query": { "type": "string", "maxLength": 4096 },
        "profile": { "const": "fixture-local" },
        "status": { "enum": ["created", "collecting", "validating", "completed", "cancelled", "blocked", "failed"] },
        "reasonCode": { "type": ["string", "null"], "maxLength": 64 },
        "sourcePolicy": { "$ref": "#/definitions/sourcePolicy" },
        "provider": { "$ref": "#/definitions/provider" },
        "sources": { "type": "array", "maxItems": 100, "items": { "$ref": "#/definitions/source" } },
        "claims": { "type": "array", "maxItems": 500 },
        "decisions": { "type": "array", "maxItems": 100 },
        "uncertainty": { "type": "array", "maxItems": 200, "items": { "type": "string", "maxLength": 2048 } },
        "metrics": { "$ref": "#/definitions/metrics" },
        "events": { "type": "array", "maxItems": 2048, "items": { "$ref": "#/definitions/event" } },
        "openQuestions": { "type": "array", "maxItems": 200, "items": { "type": "string", "maxLength": 2048 } },
        "limits": { "$ref": "#/definitions/limits" },
        "recovery": { "$ref": "#/definitions/recovery" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lineageStatus": { "enum": ["valid", "invalid"] },
        "providerVerification": { "const": "unverified" },
        "recommendationVerification": { "const": "unverified" },
        "diagnostics": { "type": "array", "maxItems": 1000 }
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "revision", "previousCheckpointHash", "artifact"],
      "properties": {
        "protocol": { "const": "aexos.research-checkpoint/v1" },
        "revision": { "type": "integer", "minimum": 1, "maximum": 512 },
        "previousCheckpointHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "artifact": { "$ref": "#/definitions/artifact" }
      }
    }
  }
}
